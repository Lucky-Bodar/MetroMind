# MetroMind — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Server ──
PORT=3000
NODE_ENV=development

# ── Database (PostgreSQL) ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=metromind_db
DB_USER=metromind_user
DB_PASSWORD=your_db_password_here

# ── JWT Auth ──
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# ── OpenStreetMap / Nominatim ──
# No key required for Nominatim (respect usage policy)
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org

# ── Weather API (OpenWeatherMap) ──
WEATHER_API_KEY=your_openweathermap_key_here
WEATHER_API_URL=https://api.openweathermap.org/data/2.5

# ── AI / ML Model Service ──
AI_MODEL_URL=http://localhost:5001
AI_MODEL_API_KEY=internal_service_key

# ── Frontend URL (for CORS) ──
FRONTEND_URL=http://localhost:3000

# ── Redis (session / rate limiting) ──
REDIS_URL=redis://localhost:6379

# ── Logging ──
LOG_LEVEL=debug
